model LeaveBalance {
  id         String   @id @default(cuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  year       Int

  totalDays  Float
  usedDays   Float    @default(0)

  allocations LeaveAllocation[]

  createdAt  DateTime @default(now())

  @@unique([userId, year])
}